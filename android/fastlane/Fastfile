default_platform(:android)

platform :android do
  desc "Build the signed release bundle (needs android/key.properties)"
  lane :build do
    sh("cd ../.. && flutter build appbundle --release")
  end

  desc "Upload the bundle to the internal testing track"
  lane :internal do
    build
    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Push store listing text, icon, feature graphic and screenshots (no binary)"
  lane :listing do
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: false,
      sync_image_upload: true,
    )
  end

  desc "Promote the current internal build to production"
  lane :promote do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
